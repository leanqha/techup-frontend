# Run the app against an in-memory mock API instead of the Go backend.
#   unset / true  -> mock is ON in local dev (`npm run dev`), OFF in production builds
#   true          -> force mock ON everywhere (e.g. a static demo build)
#   false         -> force mock OFF and use the real backend via the Vite proxy
VITE_MOCK_API=true

# Backend the Vite dev server proxies /api to when the mock is OFF.
# Matches the Go backend's PORT (see ../techup/.env.dev).
VITE_API_URL=http://localhost:3000
