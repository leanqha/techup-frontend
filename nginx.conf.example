# Example nginx site for TechUp: serve the static frontend build and proxy
# /api to the Go backend (running in Docker, published on 127.0.0.1:3000).
#
# Setup on the server:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/techup
#   sudo vim /etc/nginx/sites-available/techup        # set server_name + root
#   sudo mkdir -p /var/www/techup && sudo chown -R "$USER:$USER" /var/www/techup
#   sudo ln -sfn /etc/nginx/sites-available/techup /etc/nginx/sites-enabled/techup
#   sudo nginx -t && sudo systemctl reload nginx
#   # HTTPS: sudo certbot --nginx -d your-domain.tld

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.tld;

    # Static build rsynced here by the "Deploy Frontend" workflow
    # (FRONTEND_DEPLOY_PATH must match this root).
    root /var/www/techup;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API -> Go backend container (published on localhost:3000).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
